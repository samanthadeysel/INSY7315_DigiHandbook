<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8BC34A"
    tools:context=".policies.PoliciesBackFragment">

    <!-- Top White Rounded Sheet Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_white_rounded_top"
        android:paddingTop="20dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/backArrowImageView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintBottom_toBottomOf="@+id/pageTitleTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/pageTitleTextView"
            app:tint="@color/black" />

        <!-- Policy Category Title -->
        <TextView
            android:id="@+id/pageTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:ellipsize="end"
            android:fontFamily="@font/raleway_bold"
            android:maxLines="1"
            android:text="Nursing Policies"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/backArrowImageView"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Outer Bevel/Grey Card Framing -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pdfOuterGreyCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#EAEAEA"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:contentPadding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pageTitleTextView">

            <!-- Inner White Sheet Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp">

                    <!-- Watermark Logo Background Behind PDF -->
                    <ImageView
                        android:id="@+id/watermarkImageView"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:alpha="0.08"
                        android:contentDescription="Hospital Watermark"
                        android:src="@drawable/peh_logo_black_wording_portrait"
                        app:layout_constraintBottom_toTopOf="@+id/breadcrumbTextView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- THIS WILL ALLOW US TO RENDER PDF INSIDE THE APP -->
                    <WebView
                        android:id="@+id/pdfWebView"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintBottom_toTopOf="@id/breadcrumbTextView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Loading Spinner for Document Network Call -->
                    <ProgressBar
                        android:id="@+id/pdfProgressBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="#2690CF"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="@+id/pdfWebView"
                        app:layout_constraintEnd_toEndOf="@+id/pdfWebView"
                        app:layout_constraintStart_toStartOf="@+id/pdfWebView"
                        app:layout_constraintTop_toTopOf="@+id/pdfWebView" />

                    <!-- Breadcrumbs / Categorical File Path -->
                    <TextView
                        android:id="@+id/breadcrumbTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:ellipsize="middle"
                        android:fontFamily="@font/raleway_bold"
                        android:maxLines="1"
                        android:text="../Pre-Op &amp; Surgical Protocols/Policy 1"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- PDF Controls Toolbar -->
                    <LinearLayout
                        android:id="@+id/bottomToolbar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <ImageView
                            android:id="@+id/previousPageIcon"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Previous page"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_media_previous"
                            app:tint="@color/black" />

                        <ImageView
                            android:id="@+id/searchPdfIcon"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Search within document"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="@color/black" />

                        <ImageView
                            android:id="@+id/nextPageIcon"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Next page"
                            android:focusable="true"
                            android:padding="10dp"
                            android:rotation="180"
                            android:src="@android:drawable/ic_media_previous"
                            app:tint="@color/black" />

                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#2980b9"
        app:itemIconTint="@color/white"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>