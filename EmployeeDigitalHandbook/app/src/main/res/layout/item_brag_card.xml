<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- The Sticky Note Card Body -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPostIt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#FFFDE7"
        app:cardCornerRadius="4dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#F0E68C"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- Compliment Recipient Header -->
            <TextView
                android:id="@+id/txtToLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/raleway_bold"
                android:text="KUDOS TO:"
                android:textColor="#8D6E63"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtBragRecipient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/raleway_bold"
                android:maxLines="1"
                android:textColor="#2E1C0C"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/txtToLabel"
                app:layout_constraintEnd_toStartOf="@+id/txtBragDate"
                app:layout_constraintStart_toEndOf="@+id/txtToLabel"
                app:layout_constraintTop_toTopOf="@+id/txtToLabel"
                tools:text="Brag recipient" />

            <!-- Post Date (Right Corner) -->
            <TextView
                android:id="@+id/txtBragDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/raleway"
                android:textColor="#8D6E63"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/txtToLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txtToLabel"
                tools:text="Today" />

            <!-- Dotted Line Divider (Tear/Fold Look) -->
            <View
                android:id="@+id/dividerLine"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#E0D8B0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtToLabel" />

            <!-- Compliment Note Content -->
            <TextView
                android:id="@+id/txtBragMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/raleway"
                android:lineSpacingExtra="3dp"
                android:textColor="#3E2723"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dividerLine"
                tools:text="Brag message here" />

            <!-- Sender Signature (Bottom Right) -->
            <TextView
                android:id="@+id/txtBragSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/raleway_bold"
                android:textColor="#5D4037"
                android:textSize="12sp"
                android:textStyle="italic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtBragMessage"
                tools:text="- Brag sender" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Custom Realistic Push-Pin -->
    <ImageView
        android:id="@+id/imgPushPin"
        android:layout_width="30dp"
        android:layout_height="34dp"
        android:contentDescription="Pinned Note"
        android:elevation="8dp"
        android:src="@drawable/ic_pushpin"
        app:layout_constraintBottom_toTopOf="@+id/cardPostIt"
        app:layout_constraintEnd_toEndOf="@+id/cardPostIt"
        app:layout_constraintStart_toStartOf="@+id/cardPostIt"
        app:layout_constraintTop_toTopOf="@+id/cardPostIt" />

</androidx.constraintlayout.widget.ConstraintLayout>