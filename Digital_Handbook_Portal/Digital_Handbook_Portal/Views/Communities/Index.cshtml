@model IEnumerable<Digital_Handbook_Portal.Models.Community>

@{
    ViewData["Title"] = "Communities & Events";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Hospital Communities & Social Events</h2>
            <p class="text-muted small mb-0">Manage hospital staff gatherings, social circles, calendars, and team events.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Create New Event
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 fw-semibold border-bottom">
                    <tr>
                        <th class="ps-4" style="width: 25%;">Event Title</th>
                        <th style="width: 35%;">Description</th>
                        <th style="width: 20%;">Date & Time</th>
                        <th style="width: 15%;">Location</th>
                        <th class="text-end pe-4" style="width: 5%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="fa-solid fa-people-group text-primary me-2"></i> @item.title
                                </td>

                                <td class="text-secondary text-truncate" style="max-width: 300px;">
                                    @item.description
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border fw-normal">
                                        <i class="fa-regular fa-calendar text-primary me-1"></i> @item.eventDateTime.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </td>

                                <td class="text-dark small">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i> @item.location
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.eventId" class="btn btn-outline-secondary" title="Edit Event"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.eventId" class="btn btn-outline-info" title="Event Details"><i class="fa-solid fa-circle-info"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.eventId" class="btn btn-outline-danger" title="Delete Event"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-calendar-xmark fs-2 mb-2 d-block text-black-50"></i>
                                No active hospital community events posted yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
