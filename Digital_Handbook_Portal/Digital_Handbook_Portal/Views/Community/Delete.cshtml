@model Digital_Handbook_Portal.Models.Community

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Delete Event Confirmation</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-danger fw-semibold">Are you sure you want to permanently cancel and delete this event?</p>

                    <dl class="row">
                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.title)</dt>
                        <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.title)</dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.eventCategory)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.eventCategory)</dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.eventDateTime)</dt>
                        <dd class="col-sm-9">@Model.eventDateTime.ToString("dd MMM yyyy, HH:mm")</dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.location)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.location)</dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.description)</dt>
                        <dd class="col-sm-9 text-muted">@Html.DisplayFor(model => model.description)</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="eventId" />
                        <div class="d-flex gap-2 mt-4">
                            <input type="submit" value="Delete Permanently" class="btn btn-danger px-3" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>