@model Digital_Handbook_Portal.Models.Community

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h4 class="form-section-title mb-0">Schedule Community Event</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="title" class="form-label fw-semibold"></label>
                            <input asp-for="title" class="form-control" placeholder="e.g., Annual Wellness Day / Staff Braai" />
                            <span asp-validation-for="title" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="eventCategory" class="form-label fw-semibold"></label>
                                <select asp-for="eventCategory" class="form-select" asp-items="Html.GetEnumSelectList<Digital_Handbook_Portal.Models.EventCategory>()">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="eventCategory" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="location" class="form-label fw-semibold"></label>
                                <input asp-for="location" class="form-control" placeholder="e.g., Hospital Auditorium, Cafeteria" />
                                <span asp-validation-for="location" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="eventDateTime" class="form-label fw-semibold"></label>
                            <input asp-for="eventDateTime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="eventDateTime" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="description" class="form-label fw-semibold"></label>
                            <textarea asp-for="description" class="form-control" rows="4" placeholder="Event schedule, dress code, RSVP details, or agenda notes..."></textarea>
                            <span asp-validation-for="description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-hospital-primary px-4">Create Event</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}