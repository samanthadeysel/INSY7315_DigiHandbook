@model IEnumerable<Digital_Handbook_Portal.ViewModels.UserCpdSummaryViewModel>

@{
    ViewData["Title"] = "CPD Leaderboard";
}

<h1 class="mb-4">Staff CPD Points & Quiz Summary</h1>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Staff Name</th>
            <th>Email</th>
            <th>Total CPD Points</th>
            <th>Quizzes Attempted</th>
            <th>Quizzes Passed</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.UserName</td>
                <td>@item.Email</td>
                <td>
                    <span class="badge bg-success fs-6">+@item.TotalCpdPoints Pts</span>
                </td>
                <td>@item.TotalQuizzesAttempted</td>
                <td>@item.TotalQuizzesPassed</td>
                <td>
                    <a asp-action="UserDetails" asp-route-id="@item.UserId" class="btn btn-primary btn-sm">
                        View Quiz History
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>