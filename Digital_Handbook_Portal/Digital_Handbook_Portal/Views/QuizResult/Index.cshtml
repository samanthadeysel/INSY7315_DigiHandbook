@model IEnumerable<Digital_Handbook_Portal.Models.QuizResult>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QuizId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quiz)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ScorePercentage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CpdPointsAwarded)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPassed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompletedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.UserId)
            </td>
            <td>
                @Html.DisplayFor(model => item.User)
            </td>
            <td>
                @Html.DisplayFor(model => item.QuizId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Quiz)
            </td>
            <td>
                @Html.DisplayFor(model => item.ScorePercentage)
            </td>
            <td>
                @Html.DisplayFor(model => item.CpdPointsAwarded)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsPassed)
            </td>
            <td>
                @Html.DisplayFor(model => item.CompletedAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
