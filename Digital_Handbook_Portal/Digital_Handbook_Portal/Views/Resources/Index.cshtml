@model IEnumerable<Digital_Handbook_Portal.Models.Resource>

@{
    ViewData["Title"] = "Resources & CPD";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Resources & CPD</h2>
            <p class="text-muted small mb-0">Manage training links, online quizzes, study portals, and continuing professional development files.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Add New Resource
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 fw-semibold border-bottom">
                    <tr>
                        <th class="ps-4" style="width: 30%;">Resource Title</th>
                        <th style="width: 25%;">Resource Type / Category</th>
                        <th style="width: 30%;">External Link URL</th>
                        <th class="text-end pe-4" style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="fa-solid fa-book-bookmark text-success me-2"></i> @item.Title
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border p-2 fw-semibold">
                                        <i class="fa-solid fa-graduation-cap text-secondary me-2"></i> @item.resourceType
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.linkUrl))
                                    {
                                        <a href="@item.linkUrl" target="_blank" class="text-decoration-none d-inline-flex align-items-center gap-1 text-primary fw-medium">
                                            <i class="fa-solid fa-link small text-secondary"></i> @item.linkUrl
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small font-italic">No URL link mapped</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Title" class="btn btn-outline-secondary" title="Edit Resource"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Title" class="btn btn-outline-info" title="Resource Details"><i class="fa-solid fa-circle-info"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Title" class="btn btn-outline-danger" title="Delete Resource"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-book-bookmark fs-2 mb-2 d-block text-black-50"></i>
                                No active training resources or CPD modules uploaded yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
