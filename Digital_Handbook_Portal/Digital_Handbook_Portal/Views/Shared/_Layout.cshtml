<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PMB Eye Hospital</title>
    <!-- Font Awesome for user-shield, power-off, and card icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PMB Eye Hospital</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- CDN fallback in case the local lib folder wasn't committed to Git -->
    <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /> -->
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="portal-body">
    <!-- Green Top Header -->
    <header class="top-banner">
        <div class="hospital-identity">
<a asp-controller="Home" asp-action="Index" class="navbar-brand">
            <img src="~/images/pmb-logo.png"
                 alt="Pietermaritzburg Eye Hospital"
                 class="hospital-logo"
                 asp-append-version="true" />
                 </a>

            <div class="portal-tag-divider"></div>
            <span class="portal-badge-text">Desktop Management Portal</span>
        </div>

        <div class="admin-profile-badge">
            <span class="admin-pill">
                <i class="fa-solid fa-user"></i> @(ViewBag.AdminName ?? "Tracy") (Admin)
            </span>
            <a href="/Account/Login" class="logout-link" title="Logout">
                <i class="fa-solid fa-power-off"></i>
            </a>
        </div>
    </header>

    <!-- Overlapping White Main Content Card -->
    <div class="portal-content-wrapper">
        <main role="main" class="main-portal-card">
            @RenderBody()
        </main>
    </div>

    <footer class="portal-footer">
        &copy; 2026 Pietermaritzburg Eye Hospital &bull; Employee Digital Handbook System
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>