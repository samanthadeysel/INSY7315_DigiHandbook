<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - PMB Eye Hospital</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<script>
    // Disable Right-Click Context Menu
    document.addEventListener('contextmenu', function (e) {
        e.preventDefault();
    });

    // Block Keyboard Shortcuts (Ctrl+C, Ctrl+P, Ctrl+U, Ctrl+S, PrintScreen)
    document.addEventListener('keydown', function (e) {
        // Block Ctrl+C (Copy), Ctrl+U (Source Code), Ctrl+P (Print), Ctrl+S (Save)
        if (e.ctrlKey && (e.key === 'c' || e.key === 'C' ||
                          e.key === 'u' || e.key === 'U' ||
                          e.key === 'p' || e.key === 'P' ||
                          e.key === 's' || e.key === 'S')) {
            e.preventDefault();
            return false;
        }

        // Clear clipboard if PrintScreen key is pressed
        if (e.key === 'PrintScreen') {
            navigator.clipboard.writeText('');
            alert('Screenshots are disabled on this portal.');
        }
    });

    //Clear Clipboard on Copy attempt
    document.addEventListener('copy', function (e) {
        e.preventDefault();
    });
</script>
<body>
    @* header *@
    <header class="top-banner">
        <div class="hospital-identity">
            <img src="~/images/pmb-logo.png"
                 alt="Pietermaritzburg Eye Hospital"
                 class="hospital-logo"
                 asp-append-version="true" />

            <div class="portal-tag-divider"></div>
            <span class="portal-badge-text">Desktop Management Portal</span>
        </div>

        <div class="admin-profile-badge">
            <span><i class="fa-solid fa-user-shield"></i> @(ViewBag.AdminName ?? "Admin Lead") (Admin)</span>
            <a href="/Account/Login" class="logout-link"><i class="fa-solid fa-power-off"></i> Logout</a>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="portal-footer">
        &copy; 2026 Pietermaritzburg Eye Hospital &bull; Employee Digital Handbook System
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>