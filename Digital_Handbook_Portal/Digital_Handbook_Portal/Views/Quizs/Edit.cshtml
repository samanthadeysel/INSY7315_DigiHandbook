@model Digital_Handbook_Portal.Models.Quiz

@{
    ViewData["Title"] = "Edit Quiz";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Edit CPD Quiz</h2>
            <p class="text-muted small mb-0">Modify title, duration, passing percentage, and CPD point awards.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm border-0 col-lg-8">
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="quizId" />
                <input type="hidden" asp-for="createdAt" />

                <div class="form-group mb-3">
                    <label asp-for="title" class="control-label fw-semibold">Quiz Title</label>
                    <input asp-for="title" class="form-control" />
                    <span asp-validation-for="title" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="passingScore" class="control-label fw-semibold">Passing Score (%)</label>
                        <input asp-for="passingScore" type="number" min="1" max="100" class="form-control" />
                        <span asp-validation-for="passingScore" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="estimateTime" class="control-label fw-semibold">Estimated Duration</label>
                        <input asp-for="estimateTime" class="form-control" />
                        <span asp-validation-for="estimateTime" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="totalQuestions" class="control-label fw-semibold">Total Questions</label>
                        <input asp-for="totalQuestions" type="number" class="form-control" />
                        <span asp-validation-for="totalQuestions" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group mb-4">
                        <label asp-for="score" class="control-label fw-semibold">CPD Points Awarded</label>
                        <input asp-for="score" type="number" class="form-control" />
                        <span asp-validation-for="score" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" style="background-color: #2690CF; border-color: #2690CF;">
                        <i class="fa-solid fa-save me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}