@model IEnumerable<Digital_Handbook_Portal.Models.QuizResult>

@{
    ViewData["Title"] = "User Quiz History";
}

<div class="mb-4">
    <h1>Quiz History: @ViewData["UserName"]</h1>
    <p class="text-muted">@ViewData["UserEmail"]</p>
</div>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Quiz Title</th>
            <th>Score (%)</th>
            <th>CPD Points Earned</th>
            <th>Status</th>
            <th>Completed At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Quiz?.title ?? $"Quiz #{item.QuizId}")</td>
                <td>@item.ScorePercentage%</td>
                <td>+@item.CpdPointsAwarded</td>
                <td>
                    @if (item.IsPassed)
                    {
                        <span class="badge bg-success">Passed</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Failed</span>
                    }
                </td>
                <td>@item.CompletedAt.ToString("g")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Leaderboard</a>
</div>