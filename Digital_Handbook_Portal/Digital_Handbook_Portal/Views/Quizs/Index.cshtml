@model Digital_Handbook_Portal.ViewModels.QuizIndexViewModel

@{
    ViewData["Title"] = "CPD Quizzes & Results";
}

<div class="container-fluid p-0">
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">CPD Quizzes & Results Dashboard</h2>
            <p class="text-muted small mb-0">Manage clinical questionnaires and monitor staff CPD performance & compliance.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm" style="background-color: #2690CF; border-color: #2690CF;">
            <i class="fa-solid fa-plus me-1"></i> Create New Quiz
        </a>
    </div>

    <!-- TOP SECTION: Active Quizzes Table -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-list-check text-primary me-2"></i>Active Quizzes
            </h5>
            <span class="badge bg-light text-dark border">@Model.Quizzes.Count Quizzes</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 fw-semibold border-bottom">
                    <tr>
                        <th class="ps-3">Title</th>
                        <th>Pass Mark</th>
                        <th>Est. Time</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Quizzes != null && Model.Quizzes.Any())
                    {
                        foreach (var item in Model.Quizzes)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    @item.title
                                    <div class="text-muted small fw-normal">
                                        @(item.questions?.Count ?? item.totalQuestions) questions
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        @item.passingScore%
                                    </span>
                                </td>
                                <td class="text-secondary small">
                                    @item.estimateTime
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.quizId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.quizId" class="btn btn-outline-info" title="Details">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.quizId" class="btn btn-outline-danger" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No quizzes available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- BOTTOM SECTION: Staff CPD Points & Quiz Results Summary -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="fa-solid fa-award text-warning me-2"></i>Staff CPD Points & Quiz Summary
                </h5>
                <p class="text-muted small mb-0">Overview of completed attempts and total CPD points earned per staff member.</p>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                +@Model.QuizResults.Sum(r => r.TotalCpdPoints) Total CPD Awarded
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Staff Name</th>
                        <th>Email</th>
                        <th>Total CPD Points</th>
                        <th>Quizzes Attempted</th>
                        <th>Quizzes Passed</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.QuizResults != null && Model.QuizResults.Any())
                    {
                        foreach (var item in Model.QuizResults)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">@item.UserName</td>
                                <td>@item.Email</td>
                                <td>
                                    <span class="badge bg-success fs-6">+@item.TotalCpdPoints Pts</span>
                                </td>
                                <td>@item.TotalQuizzesAttempted</td>
                                <td>@item.TotalQuizzesPassed</td>
                                <td class="text-end pe-3">
                                    <a asp-controller="Quizs" asp-action="UserDetails" asp-route-id="@item.UserId" class="btn btn-primary btn-sm">
                                        View Quiz History
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No quiz completions recorded yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>