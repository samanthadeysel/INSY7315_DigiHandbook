@model Digital_Handbook_Portal.Models.Policy

@{
    ViewData["Title"] = "Delete Policy";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Delete Confirmation</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-danger fw-semibold">Are you sure you want to permanently delete this policy?</p>

                    <dl class="row">
                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Title)</dt>
                        <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.Title)</dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Category)</dt>
                        <dd class="col-sm-9">@(Model.Category?.categoryName ?? "Unassigned")</dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.contentSummary)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.contentSummary)</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="policyId" />
                        <div class="d-flex gap-2 mt-4">
                            <input type="submit" value="Delete Permanently" class="btn btn-danger px-3" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>