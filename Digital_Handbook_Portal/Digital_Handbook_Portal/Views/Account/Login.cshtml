@{
    Layout = null;
    ViewData["Title"] = "Admin Portal Login - PMB Eye Hospital";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;700;800&family=Verdana&display=swap" rel="stylesheet">

    <!-- Bootstrap & Portal Stylesheet -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page-body">

    <!-- Header & Logo -->
    <div class="hospital-brand-header">
        <img src="~/images/pmb-eye-hospital-logo.png"
             alt="Pietermaritzburg Eye Hospital Logo"
             class="hospital-logo"
             onerror="this.style.display='none'" />
        <div class="portal-badge">Desktop Management Portal</div>
    </div>

    <!-- Login Card Container -->
    <div class="login-card-wrapper">
        <div class="green-accent-border"></div>

        <div class="login-card">
            <h1 class="card-header-title">Login</h1>
            <p class="card-header-subtitle">Sign in to continue.</p>

            <form method="post" asp-action="Login" asp-controller="Account">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label" for="Email">Email</label>
                    <input type="email"
                           id="Email"
                           name="Email"
                           class="form-input"
                           placeholder="admin@pmbeyehospital.co.za"
                           required
                           autocomplete="email" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Password">Password</label>
                    <input type="password"
                           id="Password"
                           name="Password"
                           class="form-input"
                           placeholder="••••••"
                           required
                           autocomplete="current-password" />
                </div>

                <button type="submit" class="btn-submit">Log in</button>

                <p class="support-text">
                    Contact your IT support or admin lead for assistance.
                </p>
            </form>
        </div>
    </div>

</body>
</html>