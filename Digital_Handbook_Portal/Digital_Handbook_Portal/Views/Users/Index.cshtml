@model IEnumerable<Digital_Handbook_Portal.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2">User Management</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Create New User
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle border">
        <thead class="table-dark">
            <tr>
                <th>Email Address</th>
                <th>Password</th>
                <th style="width: 220px;" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">
                        No registered user accounts found.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(model => item.email)
                        </td>
                        <td>
                            ••••••••
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-userid="@item.userId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Details" asp-route-userid="@item.userId" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Delete" asp-route-userid="@item.userId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>