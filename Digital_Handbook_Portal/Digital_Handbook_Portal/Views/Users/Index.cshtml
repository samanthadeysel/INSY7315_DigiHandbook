@model IEnumerable<Digital_Handbook_Portal.Models.User>

@{
    ViewData["Title"] = "Users Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">User Directory</h2>
            <p class="text-muted small mb-0">Manage system users, reset account passwords, and assign system access security credentials.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-user-plus me-1"></i> Create New User
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 fw-semibold border-bottom">
                    <tr>
                        <th class="ps-4" style="width: 45%;">@Html.DisplayNameFor(model => model.email)</th>
                        <th style="width: 35%;">@Html.DisplayNameFor(model => model.password)</th>
                        <th class="text-end pe-4" style="width: 20%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="fa-regular fa-envelope me-2 text-secondary"></i> @Html.DisplayFor(modelItem => item.email)
                                </td>
                                <td>
                                    <span class="text-muted font-monospace small">••••••••••••</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.userId" class="btn btn-outline-secondary" title="Edit User"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.userId" class="btn btn-outline-info" title="View Details"><i class="fa-solid fa-circle-info"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.userId" class="btn btn-outline-danger" title="Delete User"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-slash fs-2 mb-2 d-block text-black-50"></i>
                                No system users found in the portal directory yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
