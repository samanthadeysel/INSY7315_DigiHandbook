@model Digital_Handbook_Portal.Models.User

@{
    ViewData["Title"] = "User Account Details";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="card-title fw-bold mb-0">Account Details</h4>
                    <span class="badge bg-primary">ID: #@Model.userId</span>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Full Name</dt>
                        <dd class="col-sm-8 fw-bold">@(string.IsNullOrWhiteSpace(Model.FullName) ? "N/A" : Model.FullName)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.email)</dt>
                        <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.email)</dd>

                        <dt class="col-sm-4 text-muted">Password</dt>
                        <dd class="col-sm-8 text-secondary">•••••••• (Encrypted / Protected)</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light py-3 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.userId" class="btn btn-primary">Edit Account</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>