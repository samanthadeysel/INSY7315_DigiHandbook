@model Digital_Handbook_Portal.Models.User

@{
    ViewData["Title"] = "Create User Account";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h4 class="form-section-title mb-0">Create Staff User Account</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" type="text" class="form-control" placeholder="e.g. Jane Doe" autocomplete="off" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="email" class="form-label fw-semibold"></label>
                            <input asp-for="email" type="email" class="form-control" placeholder="staff.member@pmbeyehospital.co.za" autocomplete="off" />
                            <span asp-validation-for="email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="password" class="form-label fw-semibold"></label>
                            <input asp-for="password" type="password" class="form-control" placeholder="Assign initial temporary password" autocomplete="new-password" />
                            <span asp-validation-for="password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-hospital-primary px-4">Create Account</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}