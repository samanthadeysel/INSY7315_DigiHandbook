@model IEnumerable<Digital_Handbook_Portal.Models.BragBook>

@{
    ViewData["Title"] = "Brag Book Submissions";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Brag Book</h2>
            <p class="text-muted small mb-0">Review peer compliments, shout-outs, and staff morale posts.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Create New Compliment
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 fw-semibold border-bottom">
                    <tr>
                        <th class="ps-4" style="width: 40%;">Message Content</th>
                        <th style="width: 15%;">Sender Type</th>
                        <th style="width: 20%;">Recipient</th>
                        <th style="width: 15%;">Date Posted</th>
                        <th class="text-end pe-4" style="width: 10%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-dark font-italic">
                                    <i class="fa-solid fa-quote-left text-primary me-2 opacity-50"></i>@item.content
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="fa-solid fa-user-tag me-1 text-secondary"></i> @item.senderType
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">
                                    <i class="fa-solid fa-star text-warning me-1"></i> @item.recipientName
                                </td>
                                <td class="text-secondary small">
                                    <i class="fa-regular fa-calendar-days me-1"></i> @item.datePosted.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-bragid="@item.bragId" class="btn btn-outline-secondary" title="Edit Post"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Details" asp-route-bragid="@item.bragId" class="btn btn-outline-info" title="View Details"><i class="fa-solid fa-circle-info"></i></a>
                                        <a asp-action="Delete" asp-route-bragid="@item.bragId" class="btn btn-outline-danger" title="Delete Post"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-face-smile fs-2 mb-2 d-block text-black-50"></i>
                                No compliments or morale logs submitted yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
