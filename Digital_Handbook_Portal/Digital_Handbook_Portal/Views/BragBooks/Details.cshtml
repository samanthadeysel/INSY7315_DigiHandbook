@model Digital_Handbook_Portal.Models.BragBook

@{
    ViewData["Title"] = "Shoutout Details";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                    <h4 class="form-section-title mb-0">Shoutout Details</h4>
                    <span class="badge bg-primary">ID: #@Model.bragId</span>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Recipient</dt>
                        <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.recipientName)</dd>

                        <dt class="col-sm-3 text-muted">Attribution</dt>
                        <dd class="col-sm-9">
                            <span class="badge-category">@Html.DisplayFor(model => model.senderType)</span>
                        </dd>

                        <dt class="col-sm-3 text-muted">Date Posted</dt>
                        <dd class="col-sm-9 text-secondary">@Model.datePosted.ToString("dd MMM yyyy, HH:mm")</dd>

                        <dt class="col-sm-3 text-muted">Message</dt>
                        <dd class="col-sm-9 bg-light p-3 rounded">@Html.DisplayFor(model => model.content)</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light py-3 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.bragId" class="btn btn-hospital-primary">Edit Shoutout</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>