@model Digital_Handbook_Portal.Models.Quiz

@{
    ViewData["Title"] = "Quiz Overview";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Quiz Overview</h2>
            <p class="text-muted small mb-0">Detailed view of the quiz structure and configured multiple choice questions.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.quizId" class="btn btn-primary shadow-sm" style="background-color: #2690CF; border-color: #2690CF;">
                <i class="fa-solid fa-pen me-1"></i> Edit Quiz
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Quiz Metadata Card -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i>Assessment Details</h5>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted small text-uppercase">Title</dt>
                        <dd class="col-sm-8 fw-semibold text-dark">@Model?.title</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Pass Mark</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                @Model?.passingScore% Required
                            </span>
                        </dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Est. Time</dt>
                        <dd class="col-sm-8 text-secondary">@Model?.estimateTime</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">CPD Points</dt>
                        <dd class="col-sm-8 text-secondary">@Model?.score Point(s)</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Created</dt>
                        <dd class="col-sm-8 text-secondary">@Model?.createdAt.ToString("dd MMM yyyy, HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Associated Questions List -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="fa-solid fa-list-ol text-success me-2"></i>Questions (@(Model?.questions?.Count ?? 0))
                    </h5>

                    @if (Model?.questions != null && Model.questions.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var q in Model.questions)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="fw-semibold text-dark mb-2">@q.questionText</div>
                                    <div class="ps-3 border-start border-2 border-primary">
                                        @foreach (var opt in q.options)
                                        {
                                            <div class="small mb-1 @(opt.isCorrect ? "text-success fw-bold" : "text-muted")">
                                                <i class="fa-solid @(opt.isCorrect ? "fa-circle-check text-success" : "fa-circle-dot text-muted") me-1"></i>
                                                @opt.optionText
                                                @if (opt.isCorrect)
                                                {
                                                    <span class="badge bg-success-subtle text-success ms-1">Correct Answer</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-solid fa-clipboard-list fs-3 mb-2 d-block text-black-50"></i>
                            No questions added to this quiz yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>