@model Digital_Handbook_Portal.Models.Quiz

@{
    ViewData["Title"] = "Delete Quiz";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-danger mb-1"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete CPD Quiz</h2>
            <p class="text-muted small mb-0">Are you sure you want to delete this quiz? All associated questions and MCQ options will be permanently removed.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm border-0 col-lg-7 border-start border-4 border-danger">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-3">Quiz Summary to be Deleted</h5>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted small text-uppercase">Title</dt>
                <dd class="col-sm-8 fw-bold text-dark">@Model?.title</dd>

                <dt class="col-sm-4 text-muted small text-uppercase">Passing Score</dt>
                <dd class="col-sm-8">@Model?.passingScore%</dd>

                <dt class="col-sm-4 text-muted small text-uppercase">Est. Time</dt>
                <dd class="col-sm-8">@Model?.estimateTime</dd>

                <dt class="col-sm-4 text-muted small text-uppercase">Total Questions</dt>
                <dd class="col-sm-8">@(Model?.questions?.Count ?? Model?.totalQuestions ?? 0)</dd>

                <dt class="col-sm-4 text-muted small text-uppercase">Created On</dt>
                <dd class="col-sm-8">@Model?.createdAt.ToString("dd MMM yyyy")</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="quizId" />
                <button type="submit" class="btn btn-danger shadow-sm">
                    <i class="fa-solid fa-trash me-1"></i> Confirm and Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>