@model Digital_Handbook_Portal.Models.Doctor

@{
    ViewData["Title"] = "Add Doctor";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h4 class="form-section-title mb-0">Register New Doctor</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="fName" class="form-label fw-semibold"></label>
                                <input asp-for="fName" class="form-control" placeholder="e.g., Sarah" />
                                <span asp-validation-for="fName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="lName" class="form-label fw-semibold"></label>
                                <input asp-for="lName" class="form-control" placeholder="e.g., Pillay" />
                                <span asp-validation-for="lName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="email" class="form-label fw-semibold"></label>
                                <input asp-for="email" class="form-control" type="email" placeholder="doctor@pmbeye.co.za" />
                                <span asp-validation-for="email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="phone" class="form-label fw-semibold"></label>
                                <input asp-for="phone" class="form-control" placeholder="033 123 4567" />
                                <span asp-validation-for="phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="suiteNumber" class="form-label fw-semibold"></label>
                                <input asp-for="suiteNumber" class="form-control" type="number" placeholder="e.g., 104" />
                                <span asp-validation-for="suiteNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Doctor Image</label>

                                <!-- OPTION 1: Local File Selector (Uploads to Cloud Storage via API) -->
                                <input type="file" name="uploadFile" class="form-control mb-2" accept="image/*" />

                                <!-- OPTION 2: Manual URL Entry (Direct Link or Web Address) -->
                                <input asp-for="doctorImg" class="form-control" placeholder="Or enter URL: https://... or /images/dr_photo.jpg" />

                                <span asp-validation-for="doctorImg" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-hospital-primary px-4">Register Doctor</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}