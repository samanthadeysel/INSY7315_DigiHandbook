@model Digital_Handbook_Portal.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                    <h4 class="form-section-title mb-0">Doctor Profile</h4>
                    <span class="badge bg-primary">ID: #@Model.doctorId</span>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Full Name</dt>
                        <dd class="col-sm-9 fw-bold">@Model.FullName</dd>

                        <dt class="col-sm-3 text-muted">Suite</dt>
                        <dd class="col-sm-9">
                            <span class="badge-category">Suite @Model.suiteNumber</span>
                        </dd>

                        <dt class="col-sm-3 text-muted">Email</dt>
                        <dd class="col-sm-9">
                            <a href="mailto:@Model.email">@Model.email</a>
                        </dd>

                        <dt class="col-sm-3 text-muted">Contact Number</dt>
                        <dd class="col-sm-9 text-secondary">@Model.phone</dd>

                        <dt class="col-sm-3 text-muted">Photo URL</dt>
                        <dd class="col-sm-9 text-muted small">
                            @(string.IsNullOrEmpty(Model.doctorImg) ? "No image URL set" : Model.doctorImg)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light py-3 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.doctorId" class="btn btn-hospital-primary">Edit Doctor</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>