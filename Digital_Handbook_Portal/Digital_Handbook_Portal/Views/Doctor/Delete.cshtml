@model Digital_Handbook_Portal.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Delete Doctor Confirmation</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-danger fw-semibold">Are you sure you want to remove this doctor from the hospital directory?</p>

                    <dl class="row">
                        <dt class="col-sm-3 text-muted">Doctor Name</dt>
                        <dd class="col-sm-9 fw-bold">@Model.FullName</dd>

                        <dt class="col-sm-3 text-muted">Suite #</dt>
                        <dd class="col-sm-9">Suite @Model.suiteNumber</dd>

                        <dt class="col-sm-3 text-muted">Email</dt>
                        <dd class="col-sm-9">@Model.email</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="doctorId" />
                        <div class="d-flex gap-2 mt-4">
                            <input type="submit" value="Delete Doctor" class="btn btn-danger px-3" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>