@model Digital_Handbook_Portal.Models.BragBook

@{
    ViewData["Title"] = "Delete Shoutout";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Delete Shoutout Confirmation</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-danger fw-semibold">Are you sure you want to permanently delete this shoutout?</p>

                    <dl class="row">
                        <dt class="col-sm-3 text-muted">Recipient</dt>
                        <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.recipientName)</dd>

                        <dt class="col-sm-3 text-muted">Sender</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.senderType)</dd>

                        <dt class="col-sm-3 text-muted">Date</dt>
                        <dd class="col-sm-9">@Model.datePosted.ToString("dd MMM yyyy, HH:mm")</dd>

                        <dt class="col-sm-3 text-muted">Content</dt>
                        <dd class="col-sm-9 text-muted">@Html.DisplayFor(model => model.content)</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="bragId" />
                        <div class="d-flex gap-2 mt-4">
                            <input type="submit" value="Delete Permanently" class="btn btn-danger px-3" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>