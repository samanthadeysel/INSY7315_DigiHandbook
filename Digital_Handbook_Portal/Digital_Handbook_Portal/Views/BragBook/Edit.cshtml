@model Digital_Handbook_Portal.Models.BragBook

@{
    ViewData["Title"] = "Edit Shoutout";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h4 class="form-section-title mb-0">Edit Recognition</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                        <input type="hidden" asp-for="bragId" />
                        <input type="hidden" asp-for="datePosted" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="recipientName" class="form-label fw-semibold"></label>
                                <input asp-for="recipientName" class="form-control" />
                                <span asp-validation-for="recipientName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="senderType" class="form-label fw-semibold"></label>
                                <select asp-for="senderType" class="form-select">
                                    <option value="Nurse">Nurse</option>
                                    <option value="Doctor">Doctor</option>
                                    <option value="Admin Staff">Admin Staff</option>
                                    <option value="Management">Management</option>
                                    <option value="Anonymous">Anonymous</option>
                                </select>
                                <span asp-validation-for="senderType" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="content" class="form-label fw-semibold"></label>
                            <textarea asp-for="content" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="content" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-hospital-primary px-4">Save Changes</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}