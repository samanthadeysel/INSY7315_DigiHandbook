@model IEnumerable<Digital_Handbook_Portal.Models.BragBook>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.senderType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.recipientName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.datePosted)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.content)
            </td>
            <td>
                @Html.DisplayFor(model => item.senderType)
            </td>
            <td>
                @Html.DisplayFor(model => item.recipientName)
            </td>
            <td>
                @Html.DisplayFor(model => item.datePosted)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.bragId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.bragId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.bragId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
