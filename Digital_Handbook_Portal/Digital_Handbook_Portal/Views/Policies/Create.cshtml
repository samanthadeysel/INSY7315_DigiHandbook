@model Digital_Handbook_Portal.Models.Policy

@{
    ViewData["Title"] = "Create Policy";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h4 class="form-section-title mb-0">Create New Policy</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Inpatient Fall Prevention Protocol" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="categoryId" class="form-label fw-semibold"></label>
                                <select asp-for="categoryId" class="form-select" asp-items="ViewBag.categoryId">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="categoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="specificCategory" class="form-label fw-semibold"></label>
                                <input asp-for="specificCategory" class="form-control" placeholder="e.g., Patient Care, Emergency" />
                                <span asp-validation-for="specificCategory" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="contentSummary" class="form-label fw-semibold"></label>
                            <textarea asp-for="contentSummary" class="form-control" rows="4" placeholder="Brief 1-2 sentence overview for mobile search..."></textarea>
                            <span asp-validation-for="contentSummary" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="fileUrl" class="form-label fw-semibold"></label>
                            <input asp-for="fileUrl" class="form-control" placeholder="https://... or /policies/file.pdf" />
                            <span asp-validation-for="fileUrl" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-hospital-primary px-4">Create Policy</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}