@model IEnumerable<Digital_Handbook_Portal.Models.Policy>

@{
    ViewData["Title"] = "Clinical Policies";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Clinical Policies</h2>
            <p class="text-muted small mb-0">Manage hospital clinical policies, procedural handbooks, and external reference files.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Create New Policy
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 fw-semibold border-bottom">
                    <tr>
                        <th class="ps-4" style="width: 30%;">Title</th>
                        <th style="width: 40%;">Content Summary</th>
                        <th style="width: 20%;">File URL Link</th>
                        <th class="text-end pe-4" style="width: 10%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="fa-solid fa-file-shield text-success me-2"></i> @item.Title
                                </td>

                                <td class="text-secondary text-truncate" style="max-width: 300px;">
                                    @item.contentSummary
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.fileUrl))
                                    {
                                        <a href="@item.fileUrl" target="_blank" class="badge bg-light text-primary border text-decoration-none fw-normal">
                                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View Document
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small font-italic">No URL uploaded</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.policyId" class="btn btn-outline-secondary" title="Edit Policy"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.policyId" class="btn btn-outline-info" title="Policy Details"><i class="fa-solid fa-circle-info"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.policyId" class="btn btn-outline-danger" title="Delete Policy"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open fs-2 mb-2 d-block text-black-50"></i>
                                No active clinical policies recorded in the system yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
